{
  "name": "fixotech-smart-calculator",
  "version": "1.0.0",
  "description": "Fixotech Smart Cable Tray Calculator",
  "main": "main.js",
  "author": "Fixotech",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build-installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fixotech.smartcalculator",
    "productName": "Fixotech Smart Calculator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "*.css",
      "*.js",
      "assets/**/*",
      "vendor/**/*",
      "!build-web.mjs",
      "!server/**",
      "!netlify/**",
      "!supabase/**",
      "!public/**",
      "!dist/**",
      "!**/*.xlsx",
      "!**/*.py"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icons/app-512.png"
    },
    "portable": {
      "artifactName": "Fixotech_Smart_Calculator.exe"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Fixotech_Setup.exe"
    }
  }
}
